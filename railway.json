{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildAptPackages": [],
    "providers": ["python"],
    "buildEnvVars": {
      "RAILPACK_PYTHON_VERSION": "3.11"
    }
  },
  "deploy": {
    "startCommand": "python3 serve.py",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
